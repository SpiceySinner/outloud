# Copy to `.env` and fill in. Nothing here is optional-by-default -- read the comments.
#
# The four that have to be set before anything works at all:
#   OPENAI_API_KEY  NEXT_PUBLIC_SUPABASE_URL  SUPABASE_SERVICE_ROLE_KEY  NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Everything below is generated from the real .env, names and comments only. `.env` is gitignored
# and stays that way: it is the only place a credential lives, and a credential never goes into a
# migration file, a check, or this file.

# --- OpenAI: required for any AI behaviour ---
OPENAI_USAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Recorded-attempt transcription (/api/transcribe). Needs word timestamps for freeze detection,
# so this must stay on whisper-1. (The old pointer here was to docs/voice-layer.md, which does
# not exist; the reasoning lives in the comments in app/api/realtime-token/route.ts.)
OPENAI_TRANSCRIBE_MODEL=

# Live Realtime input transcription. Deliberately a different model: this one has to stream
# transcription deltas so the placement screen can show text while the user is still speaking.
OPENAI_REALTIME_TRANSCRIBE_MODEL=

OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=

# --- Feature flags ---
# true = serve deterministic canned AI responses and never call OpenAI. Useful for testing
# without spending credits. Leave false anywhere you want real answers.
OUTLOUD_MOCK_AI=
OUTLOUD_REALTIME_ENABLED=
NEXT_PUBLIC_OUTLOUD_MOMENTS_ENABLED=

# --- Hosting ---
NEXT_PUBLIC_APP_URL=

# --- Supabase: required for saving moments, feedback and analytics ---
# Both are needed. With the URL set but the key missing, every save fails with a 503 that the
# client currently swallows silently.
# Use the service_role key, not anon -- the worker uses it server-side and it must bypass RLS.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery via Resend (optional; retrieval reminders need it) ---
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for POST /api/retrieval. If set, the scheduler must send
# Authorization: Bearer <value>.
CRON_SECRET=

# --- Discord feedback notifications (optional) ---
# DISCORD_FEEDBACK_WEBHOOK_URL takes precedence; DISCORD_WEBHOOK_URL is the fallback.
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Beta limits ---
MAX_ANONYMOUS_MOMENTS_PER_DAY=
MAX_AUDIO_SECONDS=
MAX_CONVERSATION_TURNS=
MAX_OPENAI_REQUESTS_PER_SESSION=

# Browser auth (create-account dialog). Public anon key from Supabase dashboard -> Settings -> API keys.
# Without it the dialog falls back to the email-only option.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# PostHog — product analytics. See docs/features/tracking.md.
# The project key is PUBLIC by design: it ships to the browser. Not a secret, still kept here.
# Project "OutLoud" (602373), org "THE SAUCE". US cloud, to match the us-east-2 Supabase project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Supabase login for the PostHog warehouse connector. Reads ph_sessions / ph_runs /
# ph_phrases / ph_events and NOTHING else — see supabase/202609100002_posthog_reader.sql.
# Not used by the app; kept here so the credential has one home and it is a gitignored one.
POSTHOG_READER_USER=
POSTHOG_READER_PASSWORD=
